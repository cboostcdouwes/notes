+            machine.signals.iter().find(|s| s.name == name && s.kind == kind).map(|s| (s.device, s.channel)).ok_or_else(|| format!("no {kind:?} named {name}"))
+        };
+        let (out_device, out_channel) = find(output, ethercat_port::TargetKind::DigitalOut)?;
+        let input = find(input, ethercat_port::TargetKind::DigitalIn)?;
+        let history = std::iter::repeat_n(false, delay.max(1)).collect();
+        lock(&self.world).follows.push(Follow { output: (usize::from(out_device), out_channel), input, history });
