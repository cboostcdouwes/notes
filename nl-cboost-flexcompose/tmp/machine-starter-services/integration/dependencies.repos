# The machine's services, for cdr (nl-cboost-ros-tools, deps-resolve): the top-level file. A service's key is its
# name in flexcompose.yaml; each service's own dependencies.repos brings in what it needs. Only this file may settle
# a conflict between two pins (override: true). A customer branch pins its own versions here.
# After a change: bash src/bootstrap.sh <service> --update in a dev box, and ./lock.sh before the next release.
repositories:
  example_app:
    type: git
    url: git@github.com:Cboostbv/example_app.git
    version: main
  example_driver:
    type: git
    url: git@github.com:Cboostbv/example_driver.git
    version: main
