// VS Code Dev Containers config for the dev box of the service example_driver (FLEXCOMPOSE_DESIGN.md §13); every
// service has one, in a folder under its name, and Reopen in Container asks which. Choose the target once, in the
// repo's folder: flexcompose generate --target devbox:host-src
// After that, initializeCommand repeats that choice on every open. src/ is this repo's checkout on the host, shared
// by all services' boxes; this service builds in ~/workspaces/example_driver (its build/, install/ and log/, in the
// Docker volume <project>_source_workspace). Dev Containers forwards your SSH agent and copies your git identity:
// clone, commit and push in the box. On every open, postAttachCommand runs src/bootstrap.sh for this service (its
// system dependencies; it never clones or moves a checkout: bash src/bootstrap.sh example_driver --update does), then
// your own /home/cboost-user/workspaces/bootstrap.sh if present.
{
  "name": "example_driver",
  "dockerComposeFile": "../../compose.generated.yaml",
  "service": "example_driver",
  "workspaceFolder": "/home/cboost-user/workspaces",
  "initializeCommand": "flexcompose regenerate",
  "overrideCommand": false,
  "shutdownAction": "none",
  "postAttachCommand": "bash /home/cboost-user/workspaces/src/bootstrap.sh example_driver && { [ ! -f /home/cboost-user/workspaces/bootstrap.sh ] || bash /home/cboost-user/workspaces/bootstrap.sh; }",
  "customizations": {
    "vscode": {
      // The ROS 2 extension replaces the deprecated ms-iot.vscode-ros, which also pulled in Python and C++ support.
      "extensions": ["Ranch-Hand-Robotics.rde-ros-2", "ms-python.python", "ms-vscode.cpptools"],
      // Show the checkouts under src/ in Source Control (depth 2 reaches src/<repo>).
      "settings": { "git.repositoryScanMaxDepth": 2 }
    }
  }
}
